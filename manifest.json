{
  "manifest_version": 3,
  "name": "送去大腦",
  "version": "1.6.0",
  "description": "一撳將網頁／社交帖文送去你自己嘅第二大腦 INBOX",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "scripting",
    "notifications"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "送去第二大腦",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.instagram.com/*",
        "https://*.threads.com/*",
        "https://*.threads.net/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*",
        "https://*.youtube.com/*",
        "https://*.linkedin.com/*",
        "https://*.tiktok.com/*",
        "https://*.douyin.com/*",
        "https://*.xiaohongshu.com/*",
        "https://*.rednote.com/*",
        "https://*.xiaohongshu.hk/*"
      ],
      "js": [
        "brain-common.js",
        "content-social.js",
        "post-buttons.js"
      ],
      "run_at": "document_idle"
    }
  ]
}